<resources>
    <style name="InstrumentTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:editTextStyle">@style/ProfessionalEditText</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#F3F7FA</item>
        <item name="android:colorAccent">#0F766E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0B2D42</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">#0B2D42</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/brand_mark_light</item>
    </style>
</resources>
