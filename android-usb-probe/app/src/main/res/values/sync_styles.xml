<resources>
    <!-- Isolated dialog theme: existing USB screens keep InstrumentTheme. -->
    <style name="SyncSheetTheme" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="colorPrimary">#0F766E</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#0F766E</item>
        <item name="colorSurface">#F3F7FA</item>
        <item name="colorOnSurface">#133348</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="bottomSheetStyle">@style/SyncSheetSurface</item>
        <item name="enableEdgeToEdge">false</item>
    </style>
    <style name="SyncSheetSurface" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">#F3F7FA</item>
        <item name="shapeAppearanceOverlay">@style/SyncSheetShape</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
        <item name="paddingLeftSystemWindowInsets">true</item>
        <item name="paddingRightSystemWindowInsets">true</item>
    </style>
    <style name="SyncSheetShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="SyncAccountTheme" parent="Theme.Material3.Light.Dialog.Alert">
        <item name="colorSurfaceContainerHigh">#FFFFFF</item>
        <item name="colorSecondary">#0F766E</item>
        <item name="android:editTextStyle">@style/ProfessionalEditText</item>
        <item name="android:colorAccent">#0F766E</item>
        <item name="colorPrimary">#0F766E</item>
        <item name="colorSurface">#F3F7FA</item>
        <item name="colorOnSurface">#133348</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>
